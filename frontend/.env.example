# Frontend settings. Copy to .env.local for local development. Never commit real .env files.
# Only VITE_-prefixed variables reach browser code, so never put secrets in them.

# Base URL for API calls. Leave empty to call the same origin (the dev server proxies /api and /actuator).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api and /actuator. Not exposed to the browser.
# Local default: the backend on the host. Docker Compose sets this to the backend service instead.
QMSYNC_DEV_PROXY_TARGET=http://localhost:8080
